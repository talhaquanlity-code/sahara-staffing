# ==============================================================================
# SAHARA STAFFING INC. — GODADDY APACHE / CPANEL PRODUCTION CONFIGURATION
# Hardened Security, Authorization Header Forwarding, Directory Protection & SPA Routing
# ==============================================================================

# Disable Directory Browsing / File Indexing
Options -Indexes

# ------------------------------------------------------------------------------
# 1. HTTP AUTHORIZATION & SPA ROUTING
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward Authorization header to PHP (essential for bearer token authentication)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Allow direct access to existing files and directories (API endpoints, assets, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other requests to index.html for React SPA client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 2. SENSITIVE FILE ACCESS BLOCKING
# ------------------------------------------------------------------------------
# Prevent access to hidden files, environment files, logs, backups, and source repositories
<FilesMatch "(^\.|\.(env|log|sql|bak|config|git|yml|yaml|ini|sh)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 3. HTTP SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Prevent Clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  # Enable XSS filter
  Header set X-XSS-Protection "1; mode=block"
  # Referrer policy for external links
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# 4. GZIP / DEFLATE COMPRESSION (Performance Optimization)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
